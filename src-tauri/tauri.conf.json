{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoriBox",
  "version": "2.4.0",
  "identifier": "com.softdows.boribox",
  "mainBinaryName": "boribox-pharmacy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "বোরিবক্স (BoriBox) - ফার্মেসি পিওএস ও ইনভেন্টরি",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "SoftDows",
    "copyright": "SoftDows দ্বারা তৈরিকৃত, পরিচালিত এবং স্বত্ত্ব নিয়ন্ত্রিত",
    "shortDescription": "BoriBox Pharmacy POS App",
    "longDescription": "BoriBox Offline-first Bengali Pharmacy POS & Inventory System"
  }
}
